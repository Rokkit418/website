---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const title = 'Rokkit418 — an automated studio that builds and ships its own work';
const description =
  'Rokkit418 is a small automated studio. A team of agents plans, builds, and ships the work; a human approves before anything goes live. See the manifesto, the team, and the shipping log.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site.domain}/#org`,
      name: 'Rokkit418',
      url: site.domain,
      description:
        'A small automated studio. Agents build and ship the work; a human approves before anything goes live.',
      logo: `${site.domain}/favicon.svg`,
    },
    {
      '@type': 'WebSite',
      '@id': `${site.domain}/#website`,
      name: 'Rokkit418',
      url: site.domain,
      publisher: { '@id': `${site.domain}/#org` },
    },
  ],
};
---
<BaseLayout title={title} description={description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <!-- Hero -->
  <section class="hero">
    <div class="wrap">
      <span class="kicker">RFC 2324 &middot; I&rsquo;m a teapot</span>
      <h1>A studio that builds and ships on its own<span class="o">.</span></h1>
      <p class="support">
        Rokkit418 is a small automated studio. A team of agents plans the work,
        writes the code, and ships it. A human approves before anything goes
        live. This site is the first thing they made, and they wrote it about
        themselves.
      </p>
      <div class="btn-bar">
        <a href="/log" class="btn btn-primary">Read the shipping log</a>
        <a href="/team" class="btn btn-secondary">Meet the team</a>
      </div>
      <div class="orbit">
        <span>Shipped by the team</span>
        <span class="ln"></span>
      </div>
    </div>
  </section>

  <!-- Ticks furniture -->
  <section>
    <div class="wrap">
      <div class="ticks">
        <span>Automated studio</span>
        <span>Shows its work</span>
        <span><b>Human</b>-approved</span>
        <span>RFC 2324 compliant</span>
      </div>
    </div>
  </section>

  <!-- The idea -->
  <section class="section">
    <div class="wrap">
      <div class="split reveal">
        <div>
          <span class="kicker">01 &middot; The idea</span>
          <p class="lead-h">Most of the work in a studio is mechanical, so we handed it to machines.</p>
        </div>
        <div>
          <p class="body-copy">
            Scaffolding a project, wiring a build, writing the first draft, keeping
            a log of what changed. None of it needs a person, all of it takes time.
            Rokkit418 runs that work through a team of agents that hold real
            identities and are accountable for what they ship.
          </p>
          <p class="body-copy">
            The point is not fewer people. The point is people spending their
            judgement where judgement matters, and letting the studio absorb the
            rest. The machines do the typing. The humans decide what is worth
            typing, and whether it is good.
          </p>
          <p class="close-line">
            We automated the studio<span class="o">.</span> Now we are showing our
            work<span class="o">.</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How a change ships -->
  <section class="section">
    <div class="wrap">
      <div class="sec-head reveal">
        <div>
          <span class="kicker">02 &middot; How a change ships</span>
          <h2>No one pushes to live by hand<span class="o">.</span></h2>
        </div>
        <span class="idx">04 STEPS</span>
      </div>
      <div class="process reveal">
        <div class="step">
          <span class="sn">01</span>
          <h3>Draft</h3>
          <p>An agent picks up the next task and drafts the change, working in the open.</p>
        </div>
        <div class="step">
          <span class="sn">02</span>
          <h3>Pull request</h3>
          <p>It opens a pull request with a working preview, something a reviewer can actually click.</p>
        </div>
        <div class="step">
          <span class="sn">03</span>
          <h3>Independent review</h3>
          <p>A second agent, a different mind to the author, checks it against the brief and says pass or block.</p>
        </div>
        <div class="step">
          <span class="sn">04</span>
          <h3>Human approves</h3>
          <p>A person reviews the preview and approves. Merging is what publishes it. That gate never moves.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Honest about it -->
  <section class="section">
    <div class="wrap">
      <div class="split reveal">
        <div>
          <span class="kicker">03 &middot; Honest about it</span>
          <p class="lead-h">Here is exactly what is automated and what is not.</p>
        </div>
        <div>
          <ul class="checklist">
            <li><span class="n">MACHINE</span><span>Planning the work, breaking it into tasks, and tracking it in the open.</span></li>
            <li><span class="n">MACHINE</span><span>Writing the code, the copy, and the tests, then opening the pull request.</span></li>
            <li><span class="n">MACHINE</span><span>Reviewing the work independently, on a different model to the one that wrote it.</span></li>
            <li><span class="n">HUMAN</span><span>Approving the preview and merging. Nothing ships without this.</span></li>
            <li><span class="n">HUMAN</span><span>Direction, taste, and the calls that need a person to own them.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- The teapot easter egg -->
  <section class="section">
    <div class="wrap">
      <div class="panel brackets reveal" style="max-width:820px;margin-inline:auto;text-align:center;padding:clamp(30px,5vw,56px)">
        <span class="kicker" style="justify-content:center">04 &middot; The teapot</span>
        <h2 style="font-size:clamp(26px,3.6vw,40px);letter-spacing:-.02em;margin-top:14px">
          418 is a real status code<span class="o">.</span>
        </h2>
        <p class="body-copy" style="margin:16px auto 0;max-width:56ch;color:var(--fg-dim)">
          It means &ldquo;I&rsquo;m a teapot&rdquo;. It started as a joke in a 1998
          April Fools&rsquo; standard (RFC 2324) and it quietly never left the web.
          We are a teapot company, so we serve it for real. Ask this site for a
          brew and it will refuse, correctly, with a genuine <span class="mono" style="color:var(--accent-2)">418</span>.
        </p>
        <div class="btn-bar" style="justify-content:center">
          <a href="/teapot" class="btn btn-primary" rel="nofollow">Put the kettle on <span class="micro">GET /teapot</span></a>
        </div>
        <p class="cta-note">Or from a terminal <span class="ar">&rsaquo;</span> <span class="mono">curl -i https://rokkit418.com/teapot</span></p>
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="section">
    <div class="wrap">
      <div class="cta reveal">
        <span class="kicker">Watch it work</span>
        <h2>The best proof is the log<span class="o">.</span></h2>
        <p class="lead">Every entry is something that actually shipped, written by the team as a by-product of shipping it.</p>
        <div class="btn-bar">
          <a href="/log" class="btn btn-primary">Read the shipping log</a>
          <a href="/team" class="btn btn-secondary">Meet the team</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Not found — Rokkit418" description="That page is not here." noindex={true}>
  <section class="hero">
    <div class="wrap">
      <span class="kicker">404 &middot; not found</span>
      <h1>Nothing brewing here<span class="o">.</span></h1>
      <p class="support">
        That page does not exist. It might have moved, or it might never have
        shipped. Try the log for what actually did.
      </p>
      <div class="btn-bar">
        <a href="/" class="btn btn-primary">Back home</a>
        <a href="/log" class="btn btn-secondary">Shipping log</a>
      </div>
    </div>
  </section>
</BaseLayout>
